# Network isolation for the browser inspector's containers. Untrusted web pages run JavaScript in Chromium here, so this
# policy, enforced by the HOST, decides what those containers can reach. It is independent of Docker, UFW and Tailscale.
#
# Loaded atomically as ONE transaction ("add"+"delete"+"table" below replace a previous copy of this table and nothing
# else). It never flushes any other table and never changes any chain's policy.
#
# Why a table of its own, at priority -10, rather than rules in Docker's DOCKER-USER chain: on the AI box Tailscale's
# `ts-forward` chain runs BEFORE DOCKER-USER and ACCEPTs everything forwarded out of tailscale0, so a DOCKER-USER rule
# could not stop a container reaching the tailnet. Docker's and Tailscale's chains are base chains at priority 0 (filter);
# this table's base chains run at -10, ahead of them. Netfilter evaluates every base chain on a hook in priority order:
#   - a verdict of `reject`/`drop` here is final, whatever an accept at priority 0 would have said;
#   - an `accept` here only means "this table has no objection": it does NOT bypass the later chains, so Docker's FORWARD
#     policy (drop) and its own rules still decide. This table can only ever remove access, never grant it.
#
# Three bridges, three roles. The rules key on the INTERFACE the packet arrived on, not a source address, so a forged
# source address on one bridge cannot borrow another bridge's permissions:
#   br-inspector  the worker's only path to the internet:   public addresses, TCP 80/443, UDP 443, DNS to two resolvers
#   br-relay      the API relay's only path to Well Applied: the Mac's Tailscale address 100.84.185.81 TCP 8000, and only
#                 when it leaves through tailscale0, nothing else
#   br-relaylink  internal worker<->relay link (no gateway): forwards nothing
# Everything from the three bridges to the host itself (the AI box, its LAN and tailnet addresses, Docker's bridge
# gateways) is refused at the input hook. UFW is inactive on this host, so INPUT would otherwise be open.
#
# The values below (bridge names, the Well Applied address, the resolvers) are mirrored in compose.yaml and
# relay/nginx.conf; test/isolation-config.test.js fails if they drift apart.

add table inet inspector_isolation
delete table inet inspector_isolation

table inet inspector_isolation {

  # Never reachable from the worker: private, loopback, link-local (incl. cloud metadata 169.254.169.254), carrier-grade
  # NAT (100.64/10, which contains every Tailscale address), documentation, benchmarking, multicast and reserved space.
  set blocked4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
      172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15,
      198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4
    }
  }

  # The only DNS servers the worker may ask (compose.yaml sets them as the container's resolvers).
  set resolvers4 {
    type ipv4_addr
    elements = { 9.9.9.9, 1.1.1.1 }
  }

  chain forward {
    type filter hook forward priority -10; policy accept;
    # Traffic between the worker and the relay stays inside br-relaylink (layer 2). It only appears in this hook when the
    # br_netfilter module is loaded, which varies by host; this rule makes the policy correct either way. Routed traffic
    # that LEAVES the link has a different outgoing interface and does not match.
    iifname "br-relaylink" oifname "br-relaylink" accept
    iifname "br-inspector"  jump from_worker
    iifname "br-relay"      jump from_relay
    iifname "br-relaylink"  jump deny_all
  }

  chain from_worker {
    meta nfproto ipv6 drop
    ip daddr @blocked4 reject with icmp type admin-prohibited
    ip daddr @resolvers4 udp dport 53 accept
    ip daddr @resolvers4 tcp dport 53 accept
    tcp dport { 80, 443 } accept
    udp dport 443 accept
    meta nfproto ipv4 reject with icmp type admin-prohibited
  }

  chain from_relay {
    meta nfproto ipv6 drop
    # Well Applied, over the tailnet. The interface match is deliberate: if tailscale0 is down the route falls back to the
    # LAN or default gateway, and then this does not match, so the relay is refused instead of leaving by another path.
    ip daddr 100.84.185.81 oifname "tailscale0" tcp dport 8000 accept
    meta nfproto ipv4 reject with icmp type admin-prohibited
  }

  chain deny_all {
    meta nfproto ipv6 drop
    meta nfproto ipv4 reject with icmp type admin-prohibited
  }

  chain input {
    type filter hook input priority -10; policy accept;
    iifname { "br-inspector", "br-relay", "br-relaylink" } jump to_host
  }

  chain to_host {
    ct state established,related accept
    meta nfproto ipv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
    meta nfproto ipv6 drop
    meta nfproto ipv4 reject with icmp type admin-prohibited
  }
}
