[Unit]
Description=Well Applied browser inspector (isolated)
# The worker exists only while the policy unit and its guard do. Requires= stops it when either stops; the verify step below
# refuses to start it unless the policy loaded in the kernel is exactly what was applied. Compose's own restart policies are
# "no": nothing but this unit starts the containers.
Requires=docker.service inspector-isolation.service inspector-isolation-guard.service
After=docker.service inspector-isolation.service inspector-isolation-guard.service network-online.target
Wants=network-online.target

[Service]
User=@WORKER_USER@
WorkingDirectory=@WORKER_DIR@
# "+" runs this one step as root (nft needs it) whatever User= says. A failure here means the worker does not start.
ExecStartPre=+/usr/local/sbin/inspector-isolation verify
ExecStart=/usr/bin/docker compose up --no-build --pull never --abort-on-container-exit --no-color
ExecStop=/usr/bin/docker compose stop --timeout 30
ExecStopPost=/usr/bin/docker compose down --remove-orphans
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
SyslogIdentifier=inspector-worker

[Install]
WantedBy=multi-user.target
