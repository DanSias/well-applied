# Copied to .env on the deployment host (e.g. the AI box) and filled
# in with real values — .env is gitignored and never committed. See
# README.md "Persistent deployment (normal operation)".

# Always the API relay in the isolated deployment (isolation/README.md): compose.yaml sets this itself, and the host
# firewall would refuse a direct connection to Well Applied anyway. Only the unisolated, original deployment pointed this at
# Well Applied's LAN address (see README.md "Normal development connectivity").
CAREER_TOOLKIT_URL=http://api-relay:8081

# Must match Well Applied's BROWSER_WORKER_TOKEN exactly.
BROWSER_WORKER_TOKEN=

# A stable, clearly-named identity for this deployment — shown in
# Well Applied's worker-presence badge and AgentRun.worker_identity.
BROWSER_WORKER_IDENTITY=ai-box-browser-inspector

# Optional — defaults shown. Must stay compatible with Well
# Applied's own BROWSER_WORKER_POLL_INTERVAL_SECONDS (that value in
# seconds should equal this one in milliseconds / 1000) so the
# online/offline threshold it derives stays meaningful.
BROWSER_WORKER_POLL_INTERVAL_MS=5000
BROWSER_WORKER_MAX_BACKOFF_MS=60000
BROWSER_WORKER_RESULT_RETRY_ATTEMPTS=3
BROWSER_WORKER_RESULT_RETRY_BACKOFF_MS=2000

# Optional. Exactly 1 reads forms that have no dedicated extractor (an unknown ATS, or Lever) from what the page says, read-only,
# instead of reporting them "unsupported". Default off. Never affects Greenhouse. See README.md "Generic form discovery".
# BROWSER_WORKER_GENERIC_DISCOVERY=1
