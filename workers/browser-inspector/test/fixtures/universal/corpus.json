{
  "schema": "universal-form-corpus/1",
  "purpose": "Offline, deterministic corpus for Universal Application Inspection (M0). Fixtures are append-only: changing one means updating its hash here, in review.",
  "vocabulary": {
    "kind": [
      "text",
      "email",
      "tel",
      "url",
      "textarea",
      "file",
      "select",
      "radio_group",
      "checkbox_group"
    ],
    "cardinality": [
      "single",
      "multi",
      "unknown"
    ],
    "widget": [
      "native_input",
      "native_input_hidden_behind_button",
      "native_select",
      "combobox",
      "listbox_button"
    ],
    "label_basis": [
      "accessible_name",
      "heading_context",
      "placeholder",
      "proximity_text",
      "unresolved"
    ],
    "label_confidence": [
      "structural",
      "inferred",
      "unresolved"
    ],
    "options_state": [
      "known_in_dom",
      "known_hidden_in_dom",
      "not_in_observed_dom",
      "unknown"
    ],
    "visibility": [
      "visible",
      "hidden_in_dom"
    ],
    "relation_class": [
      "declared",
      "inferred",
      "unknown"
    ],
    "outcome": [
      "complete",
      "partial",
      "unsupported",
      "application_not_found",
      "needs_application_url",
      "authentication_required",
      "mutation_required",
      "blocked"
    ],
    "evidence_class": [
      "observed",
      "api_derived",
      "inferred",
      "unknown"
    ],
    "milestone": [
      "M1",
      "M2",
      "M3",
      "M4",
      "M7"
    ]
  },
  "offline_rules": {
    "external_urls_allowed_hosts": [
      "example.test",
      "www.example.test",
      "jobs.example.test"
    ],
    "forbidden_in_fixtures": [
      "<script src",
      "<link ",
      "@import",
      "url(http",
      "Math.random",
      "Date.now",
      "new Date",
      "setTimeout",
      "setInterval",
      "XMLHttpRequest",
      "WebSocket",
      "EventSource",
      "sendBeacon"
    ],
    "scripts_may_not_run_side_effects_on_load": true
  },
