          "id": "combobox_inputs",
          "selector": "input[role='combobox']",
          "min": 10
        },
        {
          "id": "single_hidden_validation_input",
          "selector": "input[aria-hidden='true'][tabindex='-1'][required]",
          "min": 1,
          "max": 1
        },
        {
          "id": "generic_file_labels",
          "selector": "label.visually-hidden",
          "min": 4
        },
        {
          "id": "manual_entry_buttons",
          "selector": "button[data-testid$='-text']",
          "min": 2,
          "max": 2
        },
        {
          "id": "no_textarea_in_dom",
          "selector": "textarea",
          "max": 0
        },
        {
          "id": "race_only_in_inert_page_data",
